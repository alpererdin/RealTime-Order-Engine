@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject RealTimeOrderEngine.Client.Services.AuthApiService AuthApiService
@inject NavigationManager Navigation

<AuthorizeView Roles="Admin">
    <Authorized>
        <div class="flex h-screen bg-gray-100">
            <aside class="w-64 bg-gray-900 text-white flex flex-col">
                <div class="p-6 text-2xl font-bold border-b border-gray-800">
                    Admin Panel
                </div>
                <nav class="flex-1 p-4 space-y-2">
                    <NavLink href="/admin" Match="NavLinkMatch.All" class="block px-4 py-2 rounded hover:bg-gray-800" ActiveClass="bg-gray-800 bg-opacity-50">
                        Dashboard
                    </NavLink>
                    <NavLink href="/admin/products" class="block px-4 py-2 rounded hover:bg-gray-800" ActiveClass="bg-gray-800 bg-opacity-50">
                        Products
                    </NavLink>
                    <NavLink href="/admin/tables" class="block px-4 py-2 rounded hover:bg-gray-800" ActiveClass="bg-gray-800 bg-opacity-50">
                        Tables
                    </NavLink>
                    <NavLink href="/admin/staff" class="block px-4 py-2 rounded hover:bg-gray-800" ActiveClass="bg-gray-800 bg-opacity-50">
                        Staff
                    </NavLink>
                    <NavLink href="/admin/devhelper" class="block px-4 py-2 rounded hover:bg-gray-800" ActiveClass="bg-gray-800 bg-opacity-50">
                        Dev Helper
                    </NavLink>
                    <NavLink href="/admin/stock" class="block px-4 py-2 rounded hover:bg-gray-800" ActiveClass="bg-gray-800 bg-opacity-50">
                        Stock Management
                    </NavLink>
                </nav>
                <div class="p-4 border-t border-gray-800">
                    <button @onclick="Logout" class="w-full text-left px-4 py-2 text-red-400 hover:bg-gray-800 rounded transition">
                        Logout
                    </button>
                </div>
            </aside>

            <main class="flex-1 p-8 overflow-y-auto">
                @Body
            </main>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="min-h-screen flex items-center justify-center bg-gray-100">
            <div class="bg-white p-8 rounded-xl shadow-md text-center">
                <h2 class="text-2xl font-bold text-red-600 mb-4">Access Denied</h2>
                <p class="text-gray-600 mb-6">You do not have permission to view this page.</p>
                <a href="/staff" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 transition">Go Back</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private async Task Logout()
    {
        await AuthApiService.Logout();
        Navigation.NavigateTo("/staff");
    }
}