@using RealTimeOrderEngine.Shared.DTOs.Tables

<div class="fixed inset-0 bg-black bg-opacity-60 z-[70] flex items-end justify-center">
    <div class="bg-white rounded-t-2xl w-full max-w-md p-4 pb-8">
        <h2 class="text-lg font-bold text-gray-800 mb-4 text-center">Select Table</h2>
        <div class="grid grid-cols-3 gap-3">
            @foreach (var table in AllTables)
            {
                <button @onclick="() => OnSwitch.InvokeAsync(table.Id)"
                    class="p-3 rounded-xl border-2 text-center @(table.Id == CurrentTableId ? "border-blue-500 bg-blue-50" : "border-gray-200") @(table.IsOccupied ? "bg-green-50" : "")">
                    <div class="font-bold text-gray-800">@table.TableNumber</div>
                    <div class="text-xs @(table.IsOccupied ? "text-green-600" : "text-gray-400")">
                        @(table.IsOccupied ? "Occupied" : "Available")
                    </div>
                </button>
            }
        </div>
        <button @onclick="OnCancel" class="w-full mt-4 py-2 text-gray-500 text-sm">Cancel</button>
    </div>
</div>

@code {
    [Parameter] public List<TableDto> AllTables { get; set; } = new();
    [Parameter] public Guid CurrentTableId { get; set; }
    [Parameter] public EventCallback<Guid> OnSwitch { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}