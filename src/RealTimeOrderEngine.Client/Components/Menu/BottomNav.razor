<nav class="absolute bottom-0 left-0 right-0 max-w-md mx-auto bg-gray-100 border-t border-gray-300 shadow-md flex h-14 z-50">
    <button @onclick='() => OnViewChange.InvokeAsync("menu")' class="flex-1 flex flex-col items-center justify-center pt-2 pb-1 text-xs @(CurrentView == "menu" ? "text-blue-600" : "text-gray-500")">
        Menu
    </button>
    <button @onclick='() => OnViewChange.InvokeAsync("cart")' class="flex-1 flex flex-col items-center justify-center pt-2 pb-1 text-xs relative @(CurrentView == "cart" ? "text-blue-600" : "text-gray-500")">
        Cart
        @if (CartItemCount > 0)
        {
            <span class="absolute top-1 right-8 bg-red-500 text-white text-[10px] font-semibold w-4 h-4 rounded-full flex items-center justify-center">@CartItemCount</span>
        }
    </button>
    <button @onclick='() => OnViewChange.InvokeAsync("orders")' class="flex-1 flex flex-col items-center justify-center pt-2 pb-1 text-xs @(CurrentView == "orders" ? "text-blue-600" : "text-gray-500")">
        Orders
    </button>
</nav>

@code {
    [Parameter] public string CurrentView { get; set; } = "menu";
    [Parameter] public int CartItemCount { get; set; }
    [Parameter] public EventCallback<string> OnViewChange { get; set; }
}