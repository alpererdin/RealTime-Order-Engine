<div class="fixed inset-0 bg-black bg-opacity-60 backdrop-blur-sm z-[70] flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm flex flex-col overflow-hidden p-6">
        <h2 class="text-xl font-bold text-center mb-2">Rate @ProductName</h2>
        
        <div class="flex justify-center gap-2 mb-6 mt-4">
            @for (int i = 1; i <= 5; i++)
            {
                var starValue = i;
                <button @onclick="() => localRating = starValue" class="text-4xl @(localRating >= starValue ? "text-yellow-400" : "text-gray-300") transition-colors">
                    ★
                </button>
            }
        </div>

        <textarea @bind="localComment" rows="3" class="w-full p-3 border border-gray-300 rounded-lg text-sm mb-4 focus:ring-blue-500 focus:border-blue-500" placeholder="Tell us what you thought..."></textarea>

        <div class="flex gap-3">
            <button @onclick="OnCancel" class="flex-1 bg-gray-100 text-gray-700 font-semibold rounded-lg py-3 hover:bg-gray-200 transition">Cancel</button>
            <button @onclick="Submit" class="flex-1 bg-blue-500 text-white font-semibold rounded-lg py-3 hover:bg-blue-600 transition disabled:opacity-50" disabled="@(localRating == 0)">Submit</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string ProductName { get; set; } = "";
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<(int Rating, string Comment)> OnSubmit { get; set; }

    private int localRating = 0;
    private string localComment = "";

    private async Task Submit()
    {
        if (localRating > 0)
        {
            await OnSubmit.InvokeAsync((localRating, localComment));
        }
    }
}