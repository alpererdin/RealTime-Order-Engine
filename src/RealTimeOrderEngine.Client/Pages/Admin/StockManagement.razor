@page "/admin/stock"
@using RealTimeOrderEngine.Shared.DTOs.Products
@using RealTimeOrderEngine.Shared.DTOs.Stock
@inject RealTimeOrderEngine.Client.Services.ProductApiService ProductService
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

<div class="p-6 bg-gray-50 min-h-screen">
    <div class="max-w-6xl mx-auto bg-white rounded-xl shadow-sm p-6 border border-gray-200">
        <h1 class="text-2xl font-bold text-gray-800 mb-6">Stock Management</h1>

        @if (isLoading)
        {
            <div class="text-center text-gray-500 py-4">Loading products...</div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-100 border-b border-gray-200">
                            <th class="p-3 font-semibold text-gray-700">Product Name</th>
                            <th class="p-3 font-semibold text-gray-700">Track Stock</th>
                            <th class="p-3 font-semibold text-gray-700">Quantity</th>
                            <th class="p-3 font-semibold text-gray-700">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in products)
                        {
                            <tr class="border-b border-gray-100 hover:bg-gray-50">
                                <td class="p-3 text-gray-800 font-medium">@product.Name</td>
                                <td class="p-3">
                                    <input type="checkbox" @bind="product.IsStockTracked" class="w-5 h-5 text-blue-600 rounded focus:ring-blue-500 cursor-pointer" />
                                </td>
                                <td class="p-3">
                                    <input type="number" @bind="product.StockQuantity" disabled="@(!product.IsStockTracked)" class="w-24 p-2 border border-gray-300 rounded focus:ring-blue-500 focus:border-blue-500 disabled:bg-gray-100 disabled:text-gray-400" min="0" />
                                </td>
                                <td class="p-3 text-right">
                                    <button @onclick="() => SaveStock(product)" class="bg-blue-500 text-white px-4 py-2 rounded font-semibold hover:bg-blue-600 transition">
                                        Save
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<ProductDto> products = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        isLoading = true;
        var result = await ProductService.GetProductsAsync();
        products = result.OrderBy(p => p.Name).ToList();
        isLoading = false;
    }

    private async Task SaveStock(ProductDto product)
    {
        var dto = new UpdateStockDto
        {
            ProductId = product.Id,
            IsStockTracked = product.IsStockTracked,
            StockQuantity = product.StockQuantity
        };

        await ProductService.UpdateStockAsync(dto);
    }
}