@page "/admin/products"
@using RealTimeOrderEngine.Shared.DTOs.Products
@inject RealTimeOrderEngine.Client.Services.ProductApiService ProductService

<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
    <div class="flex justify-between items-center mb-4">
        <h2 class="text-2xl font-bold text-gray-800">Products Management</h2>
        <button @onclick="ShowCreateForm" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Add New Product</button>
    </div>

    @if (showForm)
    {
        <div class="mb-6 p-4 border border-gray-200 rounded bg-gray-50">
            <h3 class="text-lg font-bold mb-3">@(isEditing ? "Edit Product" : "New Product")</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <input @bind="currentProduct.Name" placeholder="Product Name" class="p-2 border rounded" />
                <input @bind="currentProduct.Price" type="number" step="0.01" placeholder="Price" class="p-2 border rounded" />
                <input @bind="currentProduct.CategoryId" placeholder="Category ID" class="p-2 border rounded" />
                <div class="flex items-center">
                    <input type="checkbox" @bind="currentProduct.IsAvailable" id="isAvail" class="mr-2" />
                    <label for="isAvail">Is Available</label>
                </div>
            </div>
            <div class="flex space-x-2">
                <button @onclick="SaveProduct" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">Save</button>
                <button @onclick="CancelForm" class="bg-gray-400 text-white px-4 py-2 rounded hover:bg-gray-500">Cancel</button>
            </div>
        </div>
    }

    <table class="w-full text-left border-collapse">
        <thead>
            <tr class="bg-gray-100 border-b">
                <th class="p-3">Name</th>
                <th class="p-3">Price</th>
                <th class="p-3">Status</th>
                <th class="p-3">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in products)
            {
                <tr class="border-b hover:bg-gray-50">
                    <td class="p-3">@p.Name</td>
                    <td class="p-3">@p.Price.ToString("C2")</td>
                    <td class="p-3">
                        <span class="@(p.IsAvailable ? "text-green-600" : "text-red-600")">
                            @(p.IsAvailable ? "Available" : "Unavailable")
                        </span>
                    </td>
                    <td class="p-3 space-x-2">
                        <button @onclick="() => EditProduct(p)" class="text-blue-600 hover:underline">Edit</button>
                        <button @onclick="() => DeleteProduct(p.Id)" class="text-red-600 hover:underline">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<ProductDto> products = new();
    private bool showForm = false;
    private bool isEditing = false;
    private UpdateProductDto currentProduct = new();
    private Guid editingProductId;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        var result = await ProductService.GetProductsAsync();
        products = result.ToList();
    }

    private void ShowCreateForm()
    {
        isEditing = false;
        currentProduct = new UpdateProductDto { IsAvailable = true };
        showForm = true;
    }

    private void EditProduct(ProductDto product)
    {
        isEditing = true;
        editingProductId = product.Id;
        currentProduct = new UpdateProductDto
        {
            Id = product.Id,
            Name = product.Name,
            Price = product.Price,
            CategoryId = product.CategoryId,
            IsAvailable = product.IsAvailable
        };
        showForm = true;
    }

    private async Task SaveProduct()
    {
        if (isEditing)
        {
            await ProductService.UpdateProductAsync(editingProductId, currentProduct);
        }
        else
        {
            var createDto = new CreateProductDto
            {
                Name = currentProduct.Name,
                Price = currentProduct.Price,
                CategoryId = currentProduct.CategoryId
            };
            await ProductService.CreateProductAsync(createDto);
        }

        showForm = false;
        await LoadProducts();
    }

    private void CancelForm()
    {
        showForm = false;
    }

    private async Task DeleteProduct(Guid id)
    {
        await ProductService.DeleteProductAsync(id);
        await LoadProducts();
    }
}