@page "/admin/devhelper"
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService _localStorage
@using System.Net.Http.Headers
@using System.Text.Json

<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">Developer Helper</h2>

    <div class="flex flex-wrap gap-2 mb-4">
        @foreach (var table in quickQueries)
        {
            <button @onclick="() => RunQuick(table)" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded-lg font-mono transition">
                @table
            </button>
        }
    </div>

    <div class="flex gap-2 mb-4">
        <textarea @bind="query" rows="3" class="flex-grow p-3 border border-gray-300 rounded-lg font-mono text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder='SELECT * FROM "Products"'></textarea>
        <button @onclick="RunQuery" class="bg-blue-600 text-white px-6 rounded-lg hover:bg-blue-700 font-semibold transition self-start py-3">
            Run
        </button>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm font-mono">
            @errorMessage
        </div>
    }

    @if (isLoading)
    {
        <div class="text-gray-400 text-sm">Running query...</div>
    }
    else if (results.Any())
    {
        <div class="text-xs text-gray-400 mb-2">@results.Count row(s) returned</div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm border-collapse">
                <thead>
                    <tr class="bg-gray-100">
                        @foreach (var col in results[0].Keys)
                        {
                            <th class="text-left p-2 border border-gray-200 font-mono text-gray-600">@col</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in results)
                    {
                        <tr class="hover:bg-gray-50 border-b border-gray-100">
                            @foreach (var val in row.Values)
                            {
                                <td class="p-2 border border-gray-200 font-mono text-gray-800 max-w-[200px] truncate">
                                    @(val?.ToString() ?? "NULL")
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private string query = "";
    private string errorMessage = "";
    private bool isLoading = false;
    private List<Dictionary<string, object?>> results = new();

    private List<string> quickQueries = new()
    {
        "SELECT * FROM \"Products\"",
        "SELECT * FROM \"Categories\"",
        "SELECT * FROM \"Tables\"",
        "SELECT * FROM \"Staffs\"",
        "SELECT * FROM \"Orders\"",
        "SELECT * FROM \"Reviews\""
    };

    private async Task RunQuick(string q)
    {
        query = q;
        await RunQuery();
    }

    private async Task RunQuery()
    {
        if (string.IsNullOrWhiteSpace(query)) return;
        errorMessage = "";
        results = new();
        isLoading = true;

        var token = await _localStorage.GetItemAsync<string>("authToken");
        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var response = await Http.PostAsJsonAsync("api/admin/query", new { Query = query });

        if (response.IsSuccessStatusCode)
        {
            var json = await response.Content.ReadAsStringAsync();
            results = JsonSerializer.Deserialize<List<Dictionary<string, object?>>>(json)
                      ?? new();
        }
        else
        {
            var err = await response.Content.ReadAsStringAsync();
            errorMessage = err;
        }

        isLoading = false;
    }
}