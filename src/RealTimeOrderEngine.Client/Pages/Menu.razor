@page "/"
@page "/{TableId}"
@using Microsoft.AspNetCore.SignalR.Client
@using RealTimeOrderEngine.Shared.DTOs.Products
@using RealTimeOrderEngine.Shared.DTOs.Orders
@using RealTimeOrderEngine.Shared.DTOs.Reviews
@using RealTimeOrderEngine.Shared.DTOs.Tables
@using RealTimeOrderEngine.Client.Components.Menu
@inject RealTimeOrderEngine.Client.Services.ProductApiService ProductService
@inject RealTimeOrderEngine.Client.Services.OrderApiService OrderService
@inject RealTimeOrderEngine.Client.Services.TableApiService TableService
@inject RealTimeOrderEngine.Client.Services.ReviewApiService ReviewService
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Blazored.LocalStorage.ILocalStorageService _localStorage
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div class="fixed inset-0 w-full h-full bg-gray-50 text-gray-900 select-none overflow-hidden z-[60]">
    @if (isInvalidUrl)
    {
        <div class="fixed inset-0 flex items-center justify-center bg-gray-100 p-6 z-[100]">
            <div class="bg-white p-8 rounded-xl shadow-lg text-center max-w-sm">
                <h2 class="text-xl font-bold text-gray-800 mb-2">Invalid Table</h2>
                <p class="text-gray-500">Please scan the QR code on your table to access the menu.</p>
            </div>
        </div>
    }
    else
    {
        <div class="max-w-md mx-auto h-full flex flex-col bg-gray-50 shadow-xl relative overflow-hidden">
            <main class="flex-grow overflow-hidden relative">
                @if (currentView == "menu")
                {
                    <div class="absolute inset-0 flex flex-col bg-gray-50">
                        <div class="px-4 py-3 bg-white/95 backdrop-blur-sm border-b border-gray-200 z-20 h-[58px] flex-none">
                            <div class="relative h-full flex items-center justify-between">
                                <h1 class="text-xl font-bold text-gray-800">Menu</h1>
                                <div class="flex items-center gap-2">
                                   <div class="flex items-center gap-2">
                                        <button @onclick="OpenTableSwitchModal" class="text-sm text-gray-700 border border-gray-300 bg-white px-3 py-1.5 rounded-lg hover:bg-gray-100 font-medium shadow-sm">
                                            Switch Table
                                        </button>
                                        <a href="/kitchen" target="_blank" class="text-sm text-white bg-orange-600 px-3 py-1.5 rounded-lg hover:bg-orange-700 font-medium shadow-sm">
                                            Kitchen
                                        </a>
                                        <a href="/staff" target="_blank" class="text-sm text-white bg-blue-600 px-3 py-1.5 rounded-lg hover:bg-blue-700 font-medium shadow-sm">
                                            Staff
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="flex-grow overflow-y-auto px-4 pb-24 pt-4">
                            @if (!products.Any())
                            {
                                <div class="text-center text-gray-500 py-8">Loading menu...</div>
                            }
                            else
                            {
                                <div class="grid grid-cols-1 gap-4">
                                    @foreach (var product in products)
                                    {
                                        <ProductCard Product="product"
                                                     Quantity="GetCartQuantity(product.Id)"
                                                     OnAdd="AddToCart"
                                                     OnDecrease="DecreaseQuantity"
                                                     OnRemove="RemoveFromCart"
                                                     OnOpenReviews="OpenReviewsModalHandler" />
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (currentView == "cart")
                {
                    <CartSummary CartItems="cart"
                                 OnCheckout="OpenCheckoutModal"
                                 OnClear="ClearCart" />
                }

                @if (currentView == "orders")
                {
                    <OrderHistory Orders="myOrders"
                                  IsReviewAllowed="isReviewAllowed"
                                  ReviewedItems="reviewedItems"
                                  OnRate="OpenRateModalHandler" />
                }
            </main>

            @if (isTableSwitchModalOpen)
            {
                <TableSwitchModal AllTables="allTables"
                                  CurrentTableId="parsedTableId"
                                  OnSwitch="SwitchTable"
                                  OnCancel="CloseTableSwitchModal" />
            }

            <BottomNav CurrentView="@currentView"
                       CartItemCount="cart.Sum(c => c.Quantity)"
                       OnViewChange="SwitchView" />

            @if (isCheckoutModalOpen)
            {
                <CheckoutModal CartItems="cart"
                               IsSubmitting="isSubmitting"
                               OnCancel="CloseCheckoutModal"
                               OnConfirm="ConfirmOrder" />
            }

            @if (isRateModalOpen)
            {
                <RateProductModal ProductName="@ratingProductName"
                                  OnCancel="CloseRateModal"
                                  OnSubmit="SubmitReview" />
            }

            @if (isReviewsModalOpen)
            {
                <ProductReviewsModal ProductName="@ratingProductName"
                                     Reviews="productReviews"
                                     OnClose="CloseReviewsModal" />
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public string? TableId { get; set; }
    
    private Guid parsedTableId;
    private bool isInvalidUrl = false;
    private Guid? currentSessionId;
    
    private IEnumerable<ProductDto> products = new List<ProductDto>();
    private List<OrderItemDto> cart = new List<OrderItemDto>();
    private List<OrderDto> myOrders = new List<OrderDto>();
    private string currentView = "menu";
    private bool isCheckoutModalOpen = false;
    private HubConnection? hubConnection;

    private bool isRateModalOpen = false;
    private Guid ratingProductId;
    private string ratingProductName = "";

    private bool isReviewsModalOpen = false;
    private IEnumerable<ReviewDto> productReviews = new List<ReviewDto>();
    private HashSet<string> reviewedItems = new();

    private bool isReviewAllowed = false;

    private bool isTableSwitchModalOpen = false;
    private List<TableDto> allTables = new();

    private bool isSubmitting = false;
    private Guid currentOrderId;

    private async Task OpenTableSwitchModal()
    {
        var result = await TableService.GetTablesAsync();
        allTables = result.OrderBy(t => t.TableNumber).ToList();
        isTableSwitchModalOpen = true;
    }

    private void CloseTableSwitchModal()
    {
        isTableSwitchModalOpen = false;
    }

    private void SwitchTable(Guid tableId)
    {
        isTableSwitchModalOpen = false;
        Navigation.NavigateTo($"/{tableId}", forceLoad: true);
    }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(TableId))
        {
            var tables = await TableService.GetTablesAsync();
            var firstTable = tables.FirstOrDefault();

            if (firstTable != null)
            {
                Navigation.NavigateTo($"/{firstTable.Id}", forceLoad: true);
                return;
            }
        }

        if (string.IsNullOrEmpty(TableId) || !Guid.TryParse(TableId, out parsedTableId))
        {
            isInvalidUrl = true;
            return;
        }

        await LoadProducts();
        StateHasChanged(); 

        var table = await TableService.GetTableByIdAsync(parsedTableId);
        if (table != null && table.IsOccupied)
        {
            currentSessionId = table.CurrentSessionId;
        }

        await LoadMyOrders();

        var apiBaseUrl = Configuration["ApiBaseUrl"] ?? "http://localhost:5211";

        hubConnection = new HubConnectionBuilder()
            .WithUrl($"{apiBaseUrl}/orderhub")
            .WithAutomaticReconnect()
            .Build();
            
        hubConnection.On<object>("OrderStatusChanged", async (_) =>
        {
            await LoadMyOrders();
            await InvokeAsync(StateHasChanged);
        });

        hubConnection.On<object>("OrderCreated", async (_) =>
        {
            await LoadMyOrders();
            await InvokeAsync(StateHasChanged);
        });

        hubConnection.On<Guid, bool>("ReviewPermissionChanged", async (tableId, isAllowed) =>
        {
            if (parsedTableId == tableId)
            {
                isReviewAllowed = isAllowed;
                await InvokeAsync(StateHasChanged);
            }
        });

        hubConnection.On<Guid, Guid>("ReviewSubmitted", async (orderId, productId) =>
        {
            var key = $"{orderId}_{productId}";
            if (!reviewedItems.Contains(key))
            {
                reviewedItems.Add(key);
                await InvokeAsync(StateHasChanged);
            }
        });

        await hubConnection.StartAsync();
    }

    private async Task LoadProducts()
    {
        products = await ProductService.GetProductsAsync();
    }

    private async Task LoadMyOrders()
    {
        var table = await TableService.GetTableByIdAsync(parsedTableId);
        if (table != null)
        {
            isReviewAllowed = table.IsReviewAllowed;
        }

        if (currentSessionId.HasValue)
        {
            var allOrders = await OrderService.GetOrdersAsync();
            myOrders = allOrders.Where(o => o.TableId == parsedTableId && o.SessionId == currentSessionId).ToList();
            
            reviewedItems.Clear();
            foreach (var order in myOrders)
            {
                var stored = await _localStorage.GetItemAsync<List<Guid>>($"reviewed_{order.Id}");
                if (stored != null)
                {
                    foreach (var id in stored)
                    {
                        reviewedItems.Add($"{order.Id}_{id}");
                    }
                }
            }
        }
        else
        {
            myOrders = new List<OrderDto>();
            reviewedItems.Clear();
        }
    }

    private int GetCartQuantity(Guid productId)
    {
        return cart.FirstOrDefault(c => c.ProductId == productId)?.Quantity ?? 0;
    }

    private void AddToCart(ProductDto product)
    {
        var existingItem = cart.FirstOrDefault(c => c.ProductId == product.Id);
        if (existingItem != null)
        {
            existingItem.Quantity++;
        }
        else
        {
            cart.Add(new OrderItemDto
            {
                ProductId = product.Id,
                ProductName = product.Name,
                UnitPrice = product.Price,
                Quantity = 1
            });
        }
    }

    private void ClearCart() => cart.Clear();

    private async Task SwitchView(string view)
    {
        currentView = view;
        if (view == "orders")
        {
            await LoadMyOrders();
        }
        StateHasChanged();
    }

    private void OpenCheckoutModal() => isCheckoutModalOpen = true;

    private void CloseCheckoutModal()
    {
        isCheckoutModalOpen = false;
    }

    private async Task ConfirmOrder(string note)
    {
        if (isSubmitting) return;
        isSubmitting = true;
        try {
            var table = await TableService.GetTableByIdAsync(parsedTableId);
            if (table == null) return;

            if (!table.IsOccupied || table.CurrentSessionId == null)
            {
                var openedTable = await TableService.OpenTableAsync(parsedTableId);
                if (openedTable != null)
                {
                    currentSessionId = openedTable.CurrentSessionId;
                }
            }
            else
            {
                currentSessionId = table.CurrentSessionId;
            }

            var createOrderDto = new CreateOrderDto
            {
                TableId = parsedTableId,
                SessionId = currentSessionId,
                Items = cart.Select(c => new CreateOrderItemDto
                {
                    ProductId = c.ProductId,
                    Quantity = c.Quantity,
                    Note = note
                }).ToList()
            };

            var result = await OrderService.CreateOrderAsync(createOrderDto);
            if (result != null)
            {
                cart.Clear();
                isCheckoutModalOpen = false;
                currentView = "orders";
                await LoadMyOrders();
            }
        }
        finally { isSubmitting = false; } 
    }

    private void DecreaseQuantity(ProductDto product)
    {
        var existingItem = cart.FirstOrDefault(c => c.ProductId == product.Id);
        if (existingItem != null && existingItem.Quantity > 1)
            existingItem.Quantity--;
    }

    private void RemoveFromCart(ProductDto product)
    {
        var existingItem = cart.FirstOrDefault(c => c.ProductId == product.Id);
        if (existingItem != null)
            cart.Remove(existingItem);
    }

    private void OpenRateModalHandler((Guid ProductId, string ProductName, Guid OrderId) args)
    {
        ratingProductId = args.ProductId;
        ratingProductName = args.ProductName;
        currentOrderId = args.OrderId;
        isRateModalOpen = true;
    }

    private void CloseRateModal()
    {
        isRateModalOpen = false;
    }

    private async Task SubmitReview((int Rating, string Comment) args)
    {
        if (args.Rating == 0 || currentOrderId == Guid.Empty) return;

        var dto = new CreateReviewDto
        {
            ProductId = ratingProductId,
            OrderId = currentOrderId,
            Rating = args.Rating,
            Comment = args.Comment
        };

        await ReviewService.CreateReviewAsync(dto);
        
        reviewedItems.Add($"{currentOrderId}_{ratingProductId}");

        var stored = await _localStorage.GetItemAsync<List<Guid>>($"reviewed_{currentOrderId}") ?? new List<Guid>();
        stored.Add(ratingProductId);
        await _localStorage.SetItemAsync($"reviewed_{currentOrderId}", stored);

        await LoadProducts();
        CloseRateModal();
    }

    private async Task OpenReviewsModalHandler(ProductDto product)
    {
        ratingProductName = product.Name;
        productReviews = await ReviewService.GetReviewsByProductIdAsync(product.Id);
        isReviewsModalOpen = true;
    }

    private void CloseReviewsModal()
    {
        isReviewsModalOpen = false;
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
            await hubConnection.DisposeAsync();
    }
}