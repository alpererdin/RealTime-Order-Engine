<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateResourceUsePreserializedResources>false</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RealTimeOrderEngine.Application\RealTimeOrderEngine.Application.csproj" />
    <ProjectReference Include="..\RealTimeOrderEngine.Infrastructure\RealTimeOrderEngine.Infrastructure.csproj" />
    <ProjectReference Include="..\RealTimeOrderEngine.Shared\RealTimeOrderEngine.Shared.csproj" />
    <ProjectReference Include="..\RealTimeOrderEngine.Client\RealTimeOrderEngine.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
      <EmbeddedResource Remove="**/*.resx" />
  </ItemGroup>

</Project>